// Basic class
class Foo {
    bar() {
        return 42;
    }
}
var f = Foo();
print f.bar();

// Properties
f.name = "Mac";
print f.name;

// Init and this
class Circle {
    init(radius) {
        this.radius = radius;
    }
    area() {
        return 3.14159 * this.radius * this.radius;
    }
}
var c = Circle(5);
print c.area();

// Inheritance
class Animal {
    speak() {
        return "...";
    }
}
class Dog < Animal {
    speak() {
        return "Woof!";
    }
}
class Cat < Animal {}
print Dog().speak();
print Cat().speak();

// Super
class A {
    method() {
        return "A method";
    }
}
class B < A {
    method() {
        return "B method";
    }
    test() {
        return super.method();
    }
}
print B().test();

// Print class and instance
print Foo;
print f;
