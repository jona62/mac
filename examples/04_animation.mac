// 04 — Animation
// Build GIFs with block syntax. Add transitions between frames.

// Simple countdown GIF — sized for social media
gif loop {
    @blank 480x480 "3" : 500ms
    @blank 480x480 "2" : 500ms
    @blank 480x480 "1" : 500ms
    @blank 480x480 "GO!" : 1s
} => "countdown.gif";

// Multi-frame story
gif loop {
    @two_panel { top: "MONDAY"    bottom: "Let's go!" } : 600ms
    @two_panel { top: "WEDNESDAY" bottom: "Almost there" } : 600ms
    @two_panel { top: "FRIDAY"    bottom: "Ship it!" } : 800ms
} => "week.gif";

// GIF with transitions between frames
// Use --- type duration [easing] --- between entries
gif loop {
    @two_panel {
        top: "Act 1"
        bottom: "The setup"
    } : 3s
    --- crossfade 200ms ---
    @two_panel {
        top: "Act 2"
        bottom: "The conflict"
    } : 3s
    --- slideLeft 200ms ---
    @two_panel {
        top: "Act 3"
        bottom: "The resolution"
    } : 3s
} => "story.gif";

// Transition types: crossfade, slideLeft, slideRight, slideUp, slideDown, wipe, fadeBlack, zoom
// Easing curves: linear, easeIn, easeOut, easeInOut, bounce

print "Animations saved to output/";
