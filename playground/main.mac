// ============================================================
//  ADVANCED MAC ANIMATION GUIDE
//  Techniques for creating cinematic, data-driven graphics
// ============================================================
//
//  1. STYLE AS IDENTITY
//     Name styles by mood. Pair outline/shadow colors with
//     the text color for depth.
//
//  2. EFFECTS AS VERBS
//     Compose named pipelines. Chain 3-4 effects max.
//
//  3. DATA-DRIVEN FRAMES
//     Arrays of maps + range() |> map() to generate frames.
//     Define styles inline from data inside lambdas.
//
//  4. SPREAD FOR COMPOSITION
//     [...a, ...b] for arrays, grid { ...frames } for grids.
//
//  5. PROGRAMMATIC GIFS
//     reduce() + Gif() + .frame() builds animations from data.
//
//  6. PACING AND RHYTHM
//     100-200ms strobes, 500ms-1s beats, 1.5-3s holds.
//     Match transition type to emotional beat.
//
//  7. CONTRAST DRIVES INTEREST
//     Alternate density with emptiness. End with simplicity.
//
// ============================================================


// ============================================================
// "DEEP" - a story in four chapters
//
// A cinematic sequence about descent into the unknown,
// discovery, transformation, and surfacing.
// Uses every transition type, function composition,
// data-driven frames, and style layering.
// ============================================================


// -- Reusable frame builder functions --

val make_title = (text, s, fx) -> @dark 800x450 s { center: text } |> fx;

val make_split = (top_text, bot_text, s, fx) ->
    @dark 800x450 s { top: top_text bottom: bot_text } |> fx;

val make_wide = (text, s, fx) -> @wide 900x400 s { center: text } |> fx;


// -- Chapter palettes --

val ch1 = { fg: "#C0D8FF", outline: "#1a2a44", glow: "#C0D8FF55" };
val ch2 = { fg: "#00FFAA", outline: "#002a1a", glow: "#00FFAA66" };
val ch3 = { fg: "#FF3366", outline: "#330015", glow: "#FF336688" };
val ch4 = { fg: "#FFD700", outline: "#332b00", glow: "#FFD70077" };

// -- Build a style from a chapter palette --
val chapter_style = (ch, weight) -> {
    style s {
        color: ch["fg"]
        outline: weight
        outlineColor: ch["outline"]
        shadow: if (weight > 2) weight + 2 else 0
        shadowColor: ch["glow"]
    }
    s
};


// -- Effect vocabularies per chapter --

effect surface    = brightness(1.1) >> contrast(1.1) >> glow(3);
effect descend    = brightness(0.7) >> contrast(1.4) >> glow(6) >> noise(0.03);
effect deep       = brightness(0.5) >> glow(10) >> chromatic(3) >> saturate(1.6);
effect abyss      = brightness(0.3) >> glow(14) >> chromatic(6) >> noise(0.08);
effect discovery  = saturate(2.5) >> glow(12) >> contrast(1.5);
effect transform  = hueShift(90) >> chromatic(8) >> glow(8) >> contrast(1.8);
effect shatter    = pixelate(3) >> noise(0.2) >> contrast(2.0) >> chromatic(4);
effect emerge     = brightness(1.2) >> glow(6) >> saturate(1.8) >> contrast(1.2);
effect clarity    = contrast(1.1) >> sharpen >> glow(2);
effect corona     = saturate(3.0) >> glow(16) >> brightness(1.3);

style whisper {
    color: "#666666"
    outline: 0
    bold: false
    uppercase: false
}

style mono {
    color: "#FFFFFF"
    outline: 0
    bold: false
    uppercase: false
}


// ============================================================
// Chapter 1: THE SURFACE
// Cool blues, gentle transitions, wide calm framing
// ============================================================

val s1 = chapter_style(ch1, 3);
val s2 = chapter_style(ch2, 3);
val s3 = chapter_style(ch3, 4);
val s4 = chapter_style(ch4, 4);

gif {

    // == Chapter 1: THE SURFACE ==
    // Cool blues, gentle transitions, wide calm framing

    @dark 800x450 whisper { center: "..." } |> brightness(0.2) : 1.2s
    --- crossfade 600ms easeIn ---

    make_title("THE SURFACE", s1, surface) : 2s
    --- slideDown 500ms easeOut ---

    make_split("still water", "clear sky", s1, surface) : 1.5s
    --- crossfade 400ms easeInOut ---
    make_wide("horizon line", s1, surface) : 1.5s
    --- crossfade 400ms easeInOut ---

    make_title("what's below?", s1, descend) : 1.5s
    --- slideDown 600ms easeIn ---


    // == Chapter 2: THE DESCENT ==
    // Greens darkening, downward slides, increasing distortion

    make_title("DESCENT", s2, descend) : 1.5s
    --- slideDown 400ms easeIn ---

    make_split("10m", "light fades", s2, descend) : 1s
    --- slideDown 300ms ---
    make_split("50m", "silence grows", s2, deep) : 1s
    --- slideDown 300ms ---
    make_split("200m", "pressure builds", s2, deep) : 1s
    --- slideDown 200ms easeIn ---
    make_split("1000m", "midnight zone", s2, abyss) : 1.2s
    --- fadeBlack 500ms ---


    // == Chapter 3: THE DISCOVERY ==
    // Hot pinks, zoom and wipe transitions, intense effects

    @dark 800x450 mono { center: "." } |> abyss : 600ms
    @dark 800x450 mono { center: ". ." } |> abyss : 400ms
    @dark 800x450 mono { center: ". . ." } |> deep : 400ms
    --- zoom 300ms bounce ---

    make_title("FOUND", s3, discovery) : 1.5s
    --- wipe 400ms ---

    make_title("it glows", s3, discovery) : 500ms
    make_title("it moves", s3, transform) : 500ms
    make_title("it knows", s3, transform) : 500ms
    --- zoom 200ms bounce ---

    make_title("CONTACT", s3, shatter) : 800ms
    --- fadeBlack 200ms ---
    make_wide("everything changes", s3, transform) : 1.5s
    --- slideRight 400ms easeOut ---


    // == Chapter 4: THE RETURN ==
    // Golds, upward slides, clarity emerging from chaos

    make_title("ASCENT", s4, emerge) : 1.5s
    --- slideUp 500ms easeOut ---

    make_split("1000m", "carrying light", s4, deep) : 800ms
    --- slideUp 300ms ---
    make_split("200m", "warmth returns", s4, descend) : 800ms
    --- slideUp 300ms ---
    make_split("50m", "colors return", s4, emerge) : 800ms
    --- slideUp 300ms easeOut ---
    make_split("10m", "almost there", s4, surface) : 800ms
    --- slideUp 400ms easeOut ---

    make_title("SURFACE", s4, corona) : 1.5s
    --- crossfade 600ms easeInOut ---

    make_wide("changed", s4, clarity) : 2s
    --- fadeBlack 400ms ---

    @dark 800x450 whisper { center: "but the deep remembers" } |> brightness(0.4) >> glow(3) : 2.5s
    --- fadeBlack 800ms ---

} => "deep.gif";

print "deep.gif saved";
