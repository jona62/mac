// Mac Standard Library
// Loaded automatically before user code.

// Pixel dimensions. Supports +, *, == operators.
class Size {
    init(w, h) {
        this.width = w;
        this.height = h;
    }
    __add__(other) {
        return Size(this.width + other.width, this.height + other.height);
    }
    __mul__(n) {
        return Size(this.width * n, this.height * n);
    }
    __eq__(other) {
        return this.width == other.width and this.height == other.height;
    }
}

// Time in milliseconds for animation frames.
// Supports +, *, == operators.
class Duration {
    init(ms) {
        this.ms = ms;
    }
    __add__(other) {
        return Duration(this.ms + other.ms);
    }
    __mul__(n) {
        return Duration(this.ms * n);
    }
    __eq__(other) {
        return this.ms == other.ms;
    }
}

// Text position on a meme.
// Use the constants Top, Bottom, or Center.
class Position {
    init(name) { this.name = name; }
    __eq__(other) { return this.name == other.name; }
}
var Top = Position("top");
var Bottom = Position("bottom");
var Center = Position("center");

// Image output format.
// Use the constants PNG, JPG, or GIF.
class Format {
    init(name) { this.name = name; }
    __eq__(other) { return this.name == other.name; }
}
var PNG = Format("png");
var JPG = Format("jpg");
var GIF = Format("gif");

// Meme template image.
// Pass a built-in name (two_panel, three_panel, bottom_text, blank)
// or a file path: Template("path/to/image.png")
class Template {
    init(nameOrPath) {
        this.name = nameOrPath;
        this.path = _resolve_template(nameOrPath);
    }
}

// Meme builder. Chain .text() to add captions,
// .save() to export, or pipe through effects with |>.
class Meme {
    init(template) {
        this.template = template;
        this.topText = "";
        this.centerText = "";
        this.bottomText = "";
        this.width = 0;
        this.height = 0;
        this.renderedPath = nil;
        this._style = nil;
    }

    // Add text at a position (Top, Bottom, Center).
    // Returns a new Meme — chainable.
    text(position, str) {
        var m = Meme(this.template);
        m.topText = this.topText;
        m.centerText = this.centerText;
        m.bottomText = this.bottomText;
        m.width = this.width;
        m.height = this.height;
        m.renderedPath = this.renderedPath;
        m._style = this._style;
        if (position == Top) m.topText = str;
        if (position == Bottom) m.bottomText = str;
        if (position == Center) m.centerText = str;
        return m;
    }

    // Save meme to a file.
    // format: PNG, JPG, or GIF. path: output file path.
    save(format, path) {
        if (this.renderedPath) {
            _save_rendered(this.renderedPath, path);
        } else {
            save(this, path);
        }
    }

    // Return a new Meme resized to the given Size.
    resize(size) {
        var m = Meme(this.template);
        m.topText = this.topText;
        m.centerText = this.centerText;
        m.bottomText = this.bottomText;
        m.width = size.width;
        m.height = size.height;
        m.renderedPath = this.renderedPath;
        m._style = this._style;
        return m;
    }
}

// Animated GIF builder. Chain .frame() to add frames,
// .save() to export. Use --- transitions in gif blocks
// for timeline-style animated GIFs.
class Gif {
    init() {
        this._gif = nil;
        this._tl = nil;
        this._frames = [];
        this.frameCount = 0;
    }

    // Add a frame with the given meme and duration.
    // Returns this — chainable.
    frame(memeObj, duration) {
        push(this._frames, {
            meme: memeObj,
            duration: duration.ms
        });
        this.frameCount = len(this._frames);
        return this;
    }

    // Render all frames and save as an animated GIF.
    save(path) {
        if (this._tl != nil) {
            _timeline_render(this._tl, path);
        } else if (this._gif != nil) {
            _gif_save_raw(this._gif, path);
        } else {
            _gif_save(this._frames, path);
        }
    }
}

// Composed effect: saturate(3.0) >> contrast(2.0) >> jpeg(10) >> noise(0.1)
var deepfry = saturate(3.0) >> contrast(2.0) >> jpeg(10) >> noise(0.1);

