// Meme image generation
var m = meme("drake", "Writing Java", "Writing Mac");
print type(m);              // expect: meme
print m.template;           // expect: drake
print m.top;                // expect: Writing Java
m.save("test_meme.png");
print "png saved";          // expect: png saved

// Resize
var small = m.resize(200, 200);
small.save("test_small.jpg");
print "jpg saved";          // expect: jpg saved

// Custom template
addTemplate("custom", "assets/templates/blank.png");
var c = meme("custom", "Custom", "Template");
print c.template;           // expect: custom
