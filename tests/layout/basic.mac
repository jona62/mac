// Test layout functions exist
print type(beside);         // expect: function
print type(stack);          // expect: function
print type(grid);           // expect: function
print type(pad);            // expect: function
print type(border);         // expect: function

// Test layout application with actual images
val t = Template("assets/templates/blank.png");
val m1 = Meme(t).text(Top, "left");
val m2 = Meme(t).text(Top, "right");

// beside
val result = beside(m1, m2);
print type(result);         // expect: map

// stack
val result2 = stack(m1, m2);
print type(result2);        // expect: map

// Pipe with beside
val result3 = m1 |> beside(m2);
print type(result3);        // expect: map

// pad
val result4 = m1 |> pad(10);
print type(result4);        // expect: map

// border
val result5 = m1 |> border(5);
print type(result5);        // expect: map

// grid
val result6 = grid(2, [m1, m2, m1, m2]);
print type(result6);        // expect: map

print "layout ok";          // expect: layout ok
