// Mac Standard Library
// Loaded automatically before user code.

// Pixel dimensions. Supports +, *, == operators.
class Size {
    init(w, h) {
        this.width = w;
        this.height = h;
    }
    __add__(other) {
        return Size(this.width + other.width, this.height + other.height);
    }
    __mul__(n) {
        return Size(this.width * n, this.height * n);
    }
    __eq__(other) {
        return this.width == other.width and this.height == other.height;
    }
}

// Time in milliseconds for animation frames.
// Supports +, *, == operators.
class Duration {
    init(ms) {
        this.ms = ms;
    }
    __add__(other) {
        return Duration(this.ms + other.ms);
    }
    __mul__(n) {
        return Duration(this.ms * n);
    }
    __eq__(other) {
        return this.ms == other.ms;
    }
}

// Text position on a meme.
// Use the constants Top, Bottom, or Center.
class Position {
    init(name) { this.name = name; }
    __eq__(other) { return this.name == other.name; }
}
var Top = Position("top");
var Bottom = Position("bottom");
var Center = Position("center");

// Image output format.
// Use the constants PNG, JPG, or GIF.
class Format {
    init(name) { this.name = name; }
    __eq__(other) { return this.name == other.name; }
}
var PNG = Format("png");
var JPG = Format("jpg");
var GIF = Format("gif");

// Meme template image.
// Pass a built-in name (two_panel, three_panel, bottom_text, blank)
// or a file path: Template("path/to/image.png")
class Template {
    init(nameOrPath) {
        this.name = nameOrPath;
        this.path = _resolve_template(nameOrPath);
    }
}

// A single animation frame pairing a Meme with a Duration.
// Created by Meme + Duration.
class Frame {
    init(memeObj, duration) {
        this.meme = memeObj;
        this.duration = duration;
    }
}

// Meme builder. Chain .text() to add captions,
// .save() to export, or pipe through effects with |>.
// Meme + Duration creates a Frame for animation.
class Meme {
    init(template) {
        this.template = template;
        this.topText = "";
        this.centerText = "";
        this.bottomText = "";
        this.width = 0;
        this.height = 0;
        this.renderedPath = nil;
        this._style = nil;
    }

    // Add text at a position (Top, Bottom, Center).
    // Returns a new Meme — chainable.
    text(position, str) {
        var m = Meme(this.template);
        m.topText = this.topText;
        m.centerText = this.centerText;
        m.bottomText = this.bottomText;
        m.width = this.width;
        m.height = this.height;
        m.renderedPath = this.renderedPath;
        m._style = this._style;
        if (position == Top) m.topText = str;
        if (position == Bottom) m.bottomText = str;
        if (position == Center) m.centerText = str;
        return m;
    }

    // Save meme to a file.
    // format: PNG, JPG, or GIF. path: output file path.
    save(format, path) {
        if (this.renderedPath) {
            _save_rendered(this.renderedPath, path);
        } else {
            save(this, path);
        }
    }

    // Return a new Meme resized to the given Size.
    resize(size) {
        var m = Meme(this.template);
        m.topText = this.topText;
        m.centerText = this.centerText;
        m.bottomText = this.bottomText;
        m.width = size.width;
        m.height = size.height;
        m.renderedPath = this.renderedPath;
        m._style = this._style;
        return m;
    }

    // Meme + Duration = Frame
    __add__(other) {
        return Frame(this, other);
    }
}

// Animated GIF builder. Chain .frame() to add frames,
// .save() to export. Gif + Frame adds a frame.
// For transitions between frames, use Timeline instead.
class Gif {
    init() {
        this._gif = nil;
        this._frames = [];
        this.frameCount = 0;
    }

    // Add a frame with the given meme and duration.
    // Returns this — chainable.
    frame(memeObj, duration) {
        push(this._frames, {
            path: memeObj.template.path,
            top: memeObj.topText,
            center: memeObj.centerText,
            bottom: memeObj.bottomText,
            width: memeObj.width,
            height: memeObj.height,
            duration: duration.ms
        });
        this.frameCount = len(this._frames);
        return this;
    }

    // Render all frames and save as an animated GIF.
    save(path) {
        if (this._gif != nil) {
            _gif_save_raw(this._gif, path);
        } else {
            _gif_save(this._frames, path);
        }
    }

    // Gif + Frame = Gif (adds the frame)
    __add__(other) {
        this.frame(other.meme, other.duration);
        return this;
    }
}

// Composed effect: saturate(3.0) >> contrast(2.0) >> jpeg(10) >> noise(0.1)
var deepfry = saturate(3.0) >> contrast(2.0) >> jpeg(10) >> noise(0.1);

// Transition type constants for Timeline.
var crossfade = "crossfade";
var slideLeft = "slideLeft";
var slideRight = "slideRight";
var slideUp = "slideUp";
var slideDown = "slideDown";
var wipe = "wipe";
var fadeBlack = "fadeBlack";
var zoom = "zoom";

// Animation timeline with transitions between keyframes.
// Chain .frame() and .transition() to build the sequence,
// then .render() or .save() to export.
// Timeline + Frame adds a keyframe.
class Timeline {
    init() {
        this._tl = timeline();
    }

    // Add a keyframe with hold duration.
    // Returns this — chainable.
    frame(memeObj, duration) {
        _timeline_keyframe(this._tl, memeObj);
        _timeline_hold(this._tl, duration.ms);
        return this;
    }

    // Set transition to the next keyframe.
    // Types: crossfade, slideLeft, slideRight, slideUp, slideDown, wipe
    transition(transType, duration) {
        _timeline_transition(this._tl, duration.ms, transType);
        return this;
    }

    // Set loop count. 0 = infinite.
    loop(count) {
        _timeline_loop(this._tl, count);
        return this;
    }

    // Render timeline to an animated GIF.
    render(path) {
        _timeline_render(this._tl, path);
        return this;
    }

    // Alias for render().
    save(path) {
        _timeline_render(this._tl, path);
        return this;
    }

    // Timeline + Frame = Timeline (adds keyframe)
    __add__(other) {
        this.frame(other.meme, other.duration);
        return this;
    }
}
