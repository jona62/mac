// Test timeline creation and types
var tl = timeline();
print type(tl);             // expect: timeline

// Timeline with keyframes
var t = Template("assets/templates/blank.png");
var m1 = Meme(t).text(Top, "frame 1");
var m2 = Meme(t).text(Top, "frame 2");

tl = _timeline_keyframe(tl, m1);
print type(tl);             // expect: timeline

tl = _timeline_hold(tl, 500);
print type(tl);             // expect: timeline

tl = _timeline_transition(tl, 300, crossfade);
print type(tl);             // expect: timeline

tl = _timeline_keyframe(tl, m2);
print type(tl);             // expect: timeline

tl = _timeline_hold(tl, 500);
tl = _timeline_loop(tl, 0);
print type(tl);             // expect: timeline

print "timeline ok";        // expect: timeline ok
