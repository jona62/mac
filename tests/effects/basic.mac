// Test effect functions exist and return callables

// Parameterized effects return callables when called with a number
print type(blur(3));        // expect: function
print type(pixelate(5));    // expect: function
print type(noise(0.1));     // expect: function
print type(saturate(2.0));  // expect: function
print type(contrast(1.5));  // expect: function
print type(brightness(1.2));// expect: function
print type(jpeg(50));       // expect: function

// Direct effects are callables
print type(invert);         // expect: function
print type(sepia);          // expect: function
print type(sharpen);        // expect: function
print type(vignette);       // expect: function

// Compose effects
var fx = blur(3) >> sepia;
print type(fx);             // expect: function

// deepfry preset exists and is callable
print type(deepfry);        // expect: function
