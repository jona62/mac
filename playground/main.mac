// ============================================================
//  ADVANCED MAC ANIMATION GUIDE
//  Techniques for creating cinematic, data-driven graphics
// ============================================================
//
//  1. STYLE AS IDENTITY
//     Name styles by mood. Pair outline/shadow colors with
//     the text color for depth.
//
//  2. EFFECTS AS VERBS
//     Compose named pipelines. Chain 3-4 effects max.
//
//  3. DATA-DRIVEN FRAMES
//     Arrays of maps + range() |> map() to generate frames.
//     Define styles inline from data inside lambdas.
//
//  4. SPREAD FOR COMPOSITION
//     [...a, ...b] for arrays, grid { ...frames } for grids.
//
//  5. PROGRAMMATIC GIFS
//     reduce() + Gif() + .frame() builds animations from data.
//
//  6. PACING AND RHYTHM
//     100-200ms strobes, 500ms-1s beats, 1.5-3s holds.
//     Match transition type to emotional beat.
//
//  7. CONTRAST DRIVES INTEREST
//     Alternate density with emptiness. End with simplicity.
//
// ============================================================


// ============================================================
// "DEEP" - a story in four chapters
//
// A cinematic sequence about descent into the unknown,
// discovery, transformation, and surfacing.
// Uses every transition type, function composition,
// data-driven frames, and style layering.
// ============================================================


// -- Reusable frame builder functions --

val make_title = (text, s, fx) -> @dark 800x450 s { center: text } |> fx;

val make_split = (top_text, bot_text, s, fx) ->
    @dark 800x450 s { top: top_text bottom: bot_text } |> fx;

val make_wide = (text, s, fx) -> @wide 900x400 s { center: text } |> fx;


// -- Chapter palettes --

val ch1 = { fg: "#C0D8FF", outline: "#1a2a44", glow: "#C0D8FF55" };
val ch2 = { fg: "#00FFAA", outline: "#002a1a", glow: "#00FFAA66" };
val ch3 = { fg: "#FF3366", outline: "#330015", glow: "#FF336688" };
val ch4 = { fg: "#FFD700", outline: "#332b00", glow: "#FFD70077" };

// -- Build a style from a chapter palette --
val chapter_style = (ch, weight) -> {
    style s {
        color: ch["fg"]
        outline: weight
        outlineColor: ch["outline"]
        shadow: if (weight > 2) weight + 2 else 0
        shadowColor: ch["glow"]
    }
    s
};


// -- Effect vocabularies per chapter --

effect surface    = brightness(1.1) >> contrast(1.1) >> glow(3);
effect descend    = brightness(0.7) >> contrast(1.4) >> glow(6) >> noise(0.03);
effect deep       = brightness(0.5) >> glow(10) >> chromatic(3) >> saturate(1.6);
effect abyss      = brightness(0.3) >> glow(14) >> chromatic(6) >> noise(0.08);
effect discovery  = saturate(2.5) >> glow(12) >> contrast(1.5);
effect transform  = hueShift(90) >> chromatic(8) >> glow(8) >> contrast(1.8);
effect shatter    = pixelate(3) >> noise(0.2) >> contrast(2.0) >> chromatic(4);
effect emerge     = brightness(1.2) >> glow(6) >> saturate(1.8) >> contrast(1.2);
effect clarity    = contrast(1.1) >> sharpen >> glow(2);
effect corona     = saturate(3.0) >> glow(16) >> brightness(1.3);

style whisper {
    color: "#666666"
    outline: 0
    bold: false
    uppercase: false
}

style mono {
    color: "#FFFFFF"
    outline: 0
    bold: false
    uppercase: false
}


val s1 = chapter_style(ch1, 3);
val s2 = chapter_style(ch2, 3);
val s3 = chapter_style(ch3, 4);
val s4 = chapter_style(ch4, 4);

gif {

    // == Chapter 1: THE SURFACE ==

    @dark 800x450 whisper { center: "..." } |> brightness(0.2) : 1.5s
    --- crossfade 600ms easeIn ---

    make_title("THE SURFACE", s1, surface) : 2.5s
    --- slideDown 600ms easeOut ---

    make_split("still water", "clear sky", s1, surface) : 2s
    --- crossfade 500ms easeInOut ---
    make_wide("horizon line", s1, surface) : 2s
    --- crossfade 500ms easeInOut ---

    make_title("what's below?", s1, descend) : 2s
    --- slideDown 600ms easeIn ---


    // == Chapter 2: THE DESCENT ==

    make_title("DESCENT", s2, descend) : 1.5s
    --- slideDown 500ms easeIn ---

    make_split("10m", "light fades", s2, descend) : 1s
    --- slideDown 400ms easeInOut ---
    make_split("50m", "silence grows", s2, deep) : 1s
    --- slideDown 400ms easeInOut ---
    make_split("200m", "pressure builds", s2, deep) : 1s
    --- slideDown 400ms easeIn ---
    make_split("1000m", "midnight zone", s2, abyss) : 1.5s
    --- fadeBlack 600ms ---


    // == Chapter 3: THE DISCOVERY ==

    @dark 800x450 mono { center: "." } |> abyss : 800ms
    @dark 800x450 mono { center: ". ." } |> abyss : 600ms
    @dark 800x450 mono { center: ". . ." } |> deep : 600ms
    --- zoom 400ms bounce ---

    make_title("FOUND", s3, discovery) : 2s
    --- wipe 500ms ---

    make_title("it glows", s3, discovery) : 700ms
    --- crossfade 300ms ---
    make_title("it moves", s3, transform) : 700ms
    --- crossfade 300ms ---
    make_title("it knows", s3, transform) : 700ms
    --- zoom 400ms bounce ---

    make_title("CONTACT", s3, shatter) : 1.2s
    --- fadeBlack 400ms ---
    make_wide("everything changes", s3, transform) : 2s
    --- slideRight 500ms easeOut ---


    // == Chapter 4: THE RETURN ==

    make_title("ASCENT", s4, emerge) : 2s
    --- slideUp 600ms easeOut ---

    make_split("1000m", "carrying light", s4, deep) : 1s
    --- slideUp 400ms easeInOut ---
    make_split("200m", "warmth returns", s4, descend) : 1s
    --- slideUp 400ms easeInOut ---
    make_split("50m", "colors return", s4, emerge) : 1s
    --- slideUp 400ms easeOut ---
    make_split("10m", "almost there", s4, surface) : 1s
    --- slideUp 500ms easeOut ---

    make_title("SURFACE", s4, corona) : 2s
    --- crossfade 600ms easeInOut ---

    make_wide("changed", s4, clarity) : 2.5s
    --- fadeBlack 500ms ---

    @dark 800x450 whisper { center: "but the deep remembers" } |> brightness(0.4) >> glow(3) : 3s
    --- fadeBlack 800ms ---

} => "deep.gif";

print "deep.gif saved";


// ============================================================
// "LAUNCH" - product feature announcement
// Techniques: customizable template, data-driven cards,
//   letter-by-letter reveal, alternating transitions
//
// Customize: product_name, tagline, launch_date, features
// ============================================================

val product_name = "NEXUS";
val tagline = "the future, shipped";
val launch_date = "06.01.26";

val features = [
    { title: "INSTANT",  detail: "zero latency" },
    { title: "INFINITE", detail: "no limits" },
    { title: "SECURE",   detail: "trust nothing" },
];

val brand_colors = ["#00EEFF", "#FF00AA", "#AAFF00", "#FF8800"];

effect reveal = glow(8) >> contrast(1.3) >> brightness(1.1);
effect card_pop = glow(6) >> contrast(1.5) >> saturate(1.6);
effect grand = saturate(3.0) >> glow(14) >> brightness(1.2);

style brand_whisper {
    color: "#555555"
    outline: 0
    bold: false
    uppercase: false
}

// Letter-by-letter name reveal
val name_frames = range(1, len(product_name) + 1) |> map(i -> {
    style build {
        color: "#FFFFFF"
        outline: 4
        outlineColor: "#111111"
        shadow: 6
        shadowColor: "#FFFFFF44"
    }
    @dark 800x450 build { center: substr(product_name, 0, i) } |> reveal
});

// Feature cards from data
val feature_frames = range(len(features)) |> map(i -> {
    val f = features[i];
    val c = brand_colors[i % len(brand_colors)];
    style feat {
        color: c
        outline: 3
        outlineColor: "#111111"
        shadow: 5
        shadowColor: "{c}66"
    }
    @dark 800x450 feat { top: f["title"] bottom: f["detail"] } |> card_pop
});

// Build the full animation
val launch_intro = name_frames
    |> reduce((g, f) -> g.frame(f, Duration(250)), Gif());

// Add tagline hold
val with_tagline = launch_intro
    .frame(@dark 800x450 brand_whisper { center: tagline } |> glow(4), Duration(2000));

// Add feature cards
val with_features = feature_frames
    |> reduce((g, f) -> g.frame(f, Duration(1500)), with_tagline);

// Date reveal + closing
style date_style {
    color: "#FFD700"
    outline: 4
    outlineColor: "#332b00"
    shadow: 8
    shadowColor: "#FFD70077"
}

with_features
    .frame(@dark 800x450 date_style { center: launch_date } |> grand, Duration(2000))
    .frame(@dark 800x450 brand_whisper { center: tagline } |> glow(3) >> brightness(0.6), Duration(2500))
    .save("launch.gif");

print "launch.gif saved";


// ============================================================
// "PRISM" - procedural color study
// Techniques: math-driven generation, effect parameterization,
//   array spread for bounce loops, reduce+Gif pattern
//
// No customization needed - pure algorithmic output
// ============================================================

style prism_anchor {
    color: "#FFFFFF"
    outline: 5
    outlineColor: "#222222"
    shadow: 3
    shadowColor: "#FFFFFF33"
}

effect prism_base = glow(8) >> contrast(1.3) >> saturate(1.8);

val base_frame = @dark 600x600 prism_anchor { center: "PRISM" } |> prism_base;

// Generate 24 hue-shifted frames across the full spectrum
val forward = range(0, 360, 15) |> map(angle ->
    base_frame |> hueShift(angle) >> glow(4)
);

// Reverse pass with increasing chromatic aberration
val backward = range(24) |> map(i ->
    forward[23 - i] |> chromatic(1 + i / 4)
);

// Bounce loop: forward + reverse
val prism_loop = [...forward, ...backward]
    |> reduce((g, f) -> g.frame(f, Duration(180)), Gif());

prism_loop.save("prism.gif");

print "prism.gif saved";


// ============================================================
// "WITNESS" - reaction GIF template
// Techniques: customizable template, meme assets,
//   effect intensification, minimal code
//
// Customize: setup_text, punch_text, reaction asset
// ============================================================

val setup_text = "when the code compiles";
val punch_text = "on the first try";

style setup_style {
    color: "#FFFFFF"
    outline: 3
    outlineColor: "#000000"
    shadow: 2
    shadowColor: "#FFFFFF33"
}

style punch_style {
    color: "#FFD700"
    outline: 4
    outlineColor: "#332b00"
    shadow: 6
    shadowColor: "#FFD70088"
}

effect punch_hit = saturate(2.0) >> glow(8) >> contrast(1.4);
effect punch_hard = saturate(3.0) >> glow(14) >> contrast(1.8) >> chromatic(3);

gif {
    // Setup
    @dark 600x600 setup_style { center: setup_text } : 2s
    --- fadeBlack 500ms ---

    // Reaction
    @meme.shrek_smirk punch_style { bottom: punch_text } |> punch_hit : 2s
    --- zoom 400ms bounce ---

    // Emphasis - same reaction, harder effects
    @meme.shrek_smirk punch_style { bottom: punch_text } |> punch_hard : 1.5s
    --- fadeBlack 600ms ---
} => "witness.gif";

print "witness.gif saved";


// ============================================================
// "SCOREBOARD" - animated stat reveal
// Techniques: data-driven frames, effect intensity from values,
//   grid spread dashboard, string interpolation
//
// Customize: stats array and title
// ============================================================

val board_title = "Q4 RESULTS";

val stats = [
    { label: "USERS",    value: "12.4K", color: "#00EEFF", intensity: 4 },
    { label: "REVENUE",  value: "$840K", color: "#00FF88", intensity: 6 },
    { label: "GROWTH",   value: "+37%",  color: "#AAFF00", intensity: 8 },
    { label: "UPTIME",   value: "99.9%", color: "#FFD700", intensity: 10 },
];

effect board_base = contrast(1.3) >> glow(4);

style title_bar {
    color: "#FFFFFF"
    outline: 3
    outlineColor: "#111111"
    shadow: 4
    shadowColor: "#FFFFFF44"
}

// Generate a styled frame per stat
val stat_frames = stats |> map(s -> {
    style stat {
        color: s["color"]
        outline: 3
        outlineColor: "#111111"
        shadow: s["intensity"]
        shadowColor: "{s[\"color\"]}88"
    }
    @dark 700x400 stat {
        top: s["label"]
        bottom: s["value"]
    } |> board_base >> glow(s["intensity"])
});

// Find the winner (last entry = highest intensity)
val winner = stats[len(stats) - 1];

style winner_style {
    color: winner["color"]
    outline: 5
    outlineColor: "#222222"
    shadow: 12
    shadowColor: "{winner[\"color\"]}99"
}

effect winner_glow = saturate(3.0) >> glow(16) >> contrast(1.5) >> chromatic(2);

gif {
    // Title
    @dark 700x400 title_bar { center: board_title } |> board_base : 2s
    --- wipe 600ms ---

    // Reveal each stat
    stat_frames[0] : 1.2s
    --- slideRight 500ms easeOut ---
    stat_frames[1] : 1.2s
    --- slideRight 500ms easeOut ---
    stat_frames[2] : 1.2s
    --- slideRight 500ms easeOut ---
    stat_frames[3] : 1.2s
    --- fadeBlack 600ms ---

    // Winner highlight
    @dark 700x400 winner_style { top: winner["label"] bottom: winner["value"] } |> winner_glow : 2.5s
    --- zoom 500ms bounce ---
    @dark 700x400 winner_style { center: winner["value"] } |> winner_glow : 2s
    --- fadeBlack 800ms ---
} => "scoreboard.gif";

print "scoreboard.gif saved";
