var a = [1, 2, 3];
print a;                    // expect: [1, 2, 3]
print a[0];                 // expect: 1
print a[2];                 // expect: 3
a[1] = 99;
print a[1];                 // expect: 99
print len(a);               // expect: 3

// Empty array
val empty = [];
print empty;                // expect: []
print len(empty);           // expect: 0

// Nested
val nested = [[1, 2], [3, 4]];
print nested[0];            // expect: [1, 2]
print nested[1][0];         // expect: 3

// Push and pop
var b = [10, 20];
push(b, 30);
print b;                    // expect: [10, 20, 30]
print pop(b);               // expect: 30
print b;                    // expect: [10, 20]
