var add = (a, b) -> a + b;
var add5 = partial(add, 5);
print add5(3);                        // expect: 8
print add5(10);                       // expect: 15

fun multiply(a, b) { return a * b; }
var double = partial(multiply, 2);
print double(5);                      // expect: 10
print double(100);                    // expect: 200

// Multiple bound args
var add3 = (a, b, c) -> a + b + c;
var addTo10 = partial(add3, 3, 7);
print addTo10(5);                     // expect: 15

// With pipes
var nums = [1, 2, 3, 4, 5];
var result = map(nums, partial(multiply, 10));
print result;                         // expect: [10, 20, 30, 40, 50]

print "partial ok";                   // expect: partial ok
