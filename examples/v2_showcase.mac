// Mac v2 Syntax Showcase
// Every bespoke feature in one file

// ── Effect Presets ──────────────────────────────────────

effect glitch = pixelate(4) >> contrast(1.8) >> noise(0.2);
effect vintage = sepia >> brightness(0.9);
effect clean = sharpen >> contrast(1.1);

// ── Static Memes ────────────────────────────────────────

@two_panel {
    top: "Me: it works on my machine"
    bottom: "Prod: lol no"
} |> glitch => "glitched_meme.png";

@two_panel {
    top: "Before functional programming"
    bottom: "After functional programming"
} |> vintage => "vintage_meme.png";

@blank "Mac: where memes are first-class citizens" => "tagline.png";

print "Static memes saved!";

// ── Countdown GIF ───────────────────────────────────────

gif loop {
    @blank "Ready?" : 800ms
    @blank "3" : 500ms
    @blank "2" : 500ms
    @blank "1" : 500ms
    @blank "GO!" : 1s
} => "countdown.gif";

print "Countdown saved!";

// ── Developer Week Arc ──────────────────────────────────

gif loop {
    @two_panel { top: "MONDAY"    bottom: "Fresh deploy" } : 600ms
    @two_panel { top: "TUESDAY"   bottom: "Minor refactor" } : 600ms
    @two_panel { top: "WEDNESDAY" bottom: "CI is broken" } : 600ms
    @two_panel { top: "THURSDAY"  bottom: "Hotfix at 2am" } : 600ms
    @two_panel { top: "FRIDAY"    bottom: "Ship it anyway" } : 800ms
} => "dev_week.gif";

print "Dev week saved!";

// ── Cinematic Timeline ──────────────────────────────────

timeline loop {
    @two_panel {
        top: "Act 1: The Setup"
        bottom: "git commit -m 'initial commit'"
    } : 3s
    --- crossfade 200ms ---
    @two_panel {
        top: "Act 2: The Conflict"
        bottom: "merge conflict in package.json"
    } : 3s
    --- slideLeft 200ms ---
    @two_panel {
        top: "Act 3: The Resolution"
        bottom: "git push --force"
    } : 3s
    --- crossfade 200ms ---
    @blank "fin." : 2s
} => "three_act.gif";

print "Timeline saved!";

// ── Effects Grid ────────────────────────────────────────

grid 2x2 {
    @blank "Clean" |> clean
    @blank "Vintage" |> vintage
    @blank "Glitch" |> glitch
    @blank "Deepfry" |> deepfry
} |> pad(5) |> border(2) => "effects_grid.png";

print "Grid saved!";

// ── Data-Driven Pipeline ────────────────────────────────
// v2 syntax composes with functional features

var quotes = [
    ["Debugging", "print('here')"],
    ["Testing", "works on my machine"],
    ["Deploying", "YOLO"],
    ["Monitoring", "This is fine"]
];

var memes = quotes |> map(q -> @two_panel {
    top: q[0]
    bottom: q[1]
});

// Fold into a timeline with transitions
var tl = memes |> reduce((tl, m) -> tl
    .frame(m, Duration(3000))
    .transition(crossfade, Duration(200)), Timeline());
tl.loop(0).render("dev_lifecycle.gif");

print "Pipeline saved!";
print "All done!";
