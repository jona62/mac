var tmpl = Template("two_panel");
var m1 = Meme(tmpl).text(Top, "Frame 1");
var m2 = Meme(tmpl).text(Top, "Frame 2");

var g = Gif()
    .frame(m1, Duration(300))
    .frame(m2, Duration(300));
print g.frameCount;               // expect: 2
g.save("typed_anim.gif");
print "gif saved";               // expect: gif saved
