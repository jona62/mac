// Gif with transitions (unified — replaces timeline)
var g = gif {
    @blank "frame 1" : 500ms
    --- crossfade 300ms ---
    @blank "frame 2" : 500ms
};
print type(g);              // expect: instance

// Simple gif still works
var g2 = gif {
    @blank "A" : 400ms
    @blank "B" : 400ms
};
print type(g2);             // expect: instance

print "gif transitions ok"; // expect: gif transitions ok
