{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mac",
  "scopeName": "source.mac",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#duration-literals" },
    { "include": "#numbers" },
    { "include": "#meme-literal" },
    { "include": "#effect-declaration" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#block-keywords" },
    { "include": "#transition-separator" },
    { "include": "#function-call" },
    { "include": "#stdlib-types" },
    { "include": "#stdlib-constants" },
    { "include": "#dunder-methods" },
    { "include": "#constants" },
    { "include": "#language-variables" },
    { "include": "#keywords" },
    { "include": "#logical-operators" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.mac",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.mac",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mac",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.mac",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "duration-literals": {
      "name": "constant.numeric.duration.mac",
      "match": "\\b\\d+(ms|s)\\b"
    },
    "meme-literal": {
      "patterns": [
        {
          "match": "(@)(\"[^\"]*\")(?:\\s+(\\d+x\\d+))?",
          "captures": {
            "1": { "name": "punctuation.definition.meme.mac" },
            "2": { "name": "string.quoted.double.template.mac" },
            "3": { "name": "constant.numeric.size.mac" }
          }
        },
        {
          "match": "(@)(\\w+)(?:\\s+(\\d+x\\d+))?",
          "captures": {
            "1": { "name": "punctuation.definition.meme.mac" },
            "2": { "name": "entity.name.tag.template.mac" },
            "3": { "name": "constant.numeric.size.mac" }
          }
        }
      ]
    },
    "effect-declaration": {
      "match": "\\b(effect)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.mac" },
        "2": { "name": "entity.name.function.effect.mac" }
      }
    },
    "block-keywords": {
      "name": "keyword.control.block.mac",
      "match": "\\b(gif|timeline|grid|loop)\\b(?=\\s+[{\\w\\d])"
    },
    "transition-separator": {
      "name": "punctuation.separator.transition.mac",
      "match": "---"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mac",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.mac",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "language-variables": {
      "name": "variable.language.mac",
      "match": "\\b(this|super)\\b"
    },
    "keywords": {
      "name": "keyword.control.mac",
      "match": "\\b(var|fun|effect|class|for|while|if|else|return|print|in|break|continue)\\b"
    },
    "logical-operators": {
      "name": "keyword.operator.logical.mac",
      "match": "\\b(and|or)\\b"
    },
    "class-declaration": {
      "match": "\\b(class)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.mac" },
        "2": { "name": "entity.name.type.class.mac" }
      }
    },
    "function-declaration": {
      "match": "\\b(fun)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.mac" },
        "2": { "name": "entity.name.function.mac" }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.mac" }
      }
    },
    "stdlib-types": {
      "name": "support.class.mac",
      "match": "\\b(Template|Meme|Gif|Timeline|Frame|Size|Duration|Position|Format)\\b"
    },
    "stdlib-constants": {
      "name": "support.constant.mac",
      "match": "\\b(Top|Bottom|Center|PNG|JPG|GIF|crossfade|slideLeft|slideRight|slideUp|slideDown|wipe|deepfry)\\b"
    },
    "dunder-methods": {
      "name": "support.function.magic.mac",
      "match": "\\b(__add__|__sub__|__mul__|__div__|__mod__|__eq__|__ne__|__lt__|__gt__|__le__|__ge__|__neg__|__not__)\\b"
    },
    "operators": {
      "name": "keyword.operator.mac",
      "match": "=>|->|\\|>|>>|==|!=|<=|>=|[+\\-*/!<>=%@]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.mac",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.mac",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.mac",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.mac",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.mac",
          "match": "\\."
        }
      ]
    }
  }
}
