// Basic value matching
var x = match 42 {
    0 -> "zero"
    42 -> "forty-two"
    _ -> "other"
};
print x;                              // expect: forty-two

// String matching
var greeting = match "hello" {
    "hi" -> "informal"
    "hello" -> "formal"
    _ -> "unknown"
};
print greeting;                       // expect: formal

// Wildcard
var y = match 999 {
    1 -> "one"
    2 -> "two"
    _ -> "many"
};
print y;                              // expect: many

// No match returns nil
var z = match "x" {
    "a" -> 1
    "b" -> 2
};
print z;                              // expect: nil

// Match with expressions in patterns
var n = 5;
var result = match n {
    2 + 3 -> "five"
    _ -> "not five"
};
print result;                         // expect: five

// Match on type()
var t = match type(42) {
    "number" -> "num"
    "string" -> "str"
    _ -> "other"
};
print t;                              // expect: num

// Boolean matching
var b = match true {
    false -> "no"
    true -> "yes"
};
print b;                              // expect: yes

// Match with string interpolation in result
var score = 95;
var grade = match score {
    100 -> "Perfect!"
    _ -> "Score: {score}"
};
print grade;                          // expect: Score: 95

// Match result used in expression
print match 1 + 1 {
    2 -> "correct"
    _ -> "wrong"
};                                    // expect: correct
