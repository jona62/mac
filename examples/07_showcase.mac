// 07 — Showcase
// Everything together: v2 syntax, functional pipelines, effects,
// animation, and data-driven meme generation.

// ── Effect Presets ──────────────────────────────────────

effect glitch = pixelate(4) >> contrast(1.8) >> noise(0.2);
effect vintage = sepia >> brightness(0.9);
effect clean = sharpen >> contrast(1.1);

// ── Hero Meme ───────────────────────────────────────────

@two_panel {
    top: "Me: it works on my machine"
    bottom: "Prod: lol no"
} |> glitch => "hero.png";

// ── Countdown ───────────────────────────────────────────

gif loop {
    @blank "Ready?" : 800ms
    @blank "3" : 500ms
    @blank "2" : 500ms
    @blank "1" : 500ms
    @blank "GO!" : 1s
} => "countdown.gif";

// ── Developer Week Arc ──────────────────────────────────

var days = [
    ["MONDAY",    "Fresh deploy, clean slate"],
    ["TUESDAY",   "Minor refactor, no big deal"],
    ["WEDNESDAY", "Why is CI failing?"],
    ["THURSDAY",  "Emergency hotfix at 2am"],
    ["FRIDAY",    "Ship it anyway"]
];

var day_memes = days |> map(d -> @two_panel {
    top: d[0]
    bottom: d[1]
});

// Fold into a GIF with uniform timing
var week = day_memes |> reduce(
    (g, m) -> g.frame(m, Duration(700)), Gif());
week.save("dev_week.gif");

// ── Cinematic Timeline ──────────────────────────────────

timeline loop {
    @two_panel {
        top: "Act 1: The Setup"
        bottom: "git init"
    } : 3s
    --- crossfade 200ms ---
    @two_panel {
        top: "Act 2: The Conflict"
        bottom: "merge conflict in package.json"
    } : 3s
    --- slideLeft 200ms ---
    @two_panel {
        top: "Act 3: The Resolution"
        bottom: "git push --force"
    } : 3s
    --- crossfade 200ms ---
    @blank "fin." : 2s
} => "three_acts.gif";

// ── Effects Comparison ──────────────────────────────────

grid 2x2 {
    @blank "Clean" |> clean
    @blank "Vintage" |> vintage
    @blank "Glitch" |> glitch
    @blank "Deepfry" |> deepfry
} |> pad(5) |> border(2) => "effects_grid.png";

// ── Data-Driven Pipeline ────────────────────────────────
// Generate memes from data, apply escalating effects,
// fold into a cinematic timeline.

var quotes = [
    ["Debugging", "print('here')"],
    ["Testing",   "works on my machine"],
    ["Deploying", "YOLO"],
    ["Monitoring", "This is fine"]
];

var memes = quotes |> map(q -> @two_panel {
    top: q[0]
    bottom: q[1]
});

var tl = memes |> reduce((tl, m) -> tl
    .frame(m, Duration(3000))
    .transition(crossfade, Duration(200)), Timeline());
tl.loop(0).render("dev_lifecycle.gif");

print "Showcase complete! Check output/";
