// WxH size in meme literals
val m = @blank 400x300 "Sized";
print type(m);                       // expect: instance

val m2 = @two_panel 800x600 {
    top: "Wide"
    bottom: "Meme"
};
print type(m2);                      // expect: instance

// Default size (no WxH)
val m3 = @blank "Default";
print type(m3);                      // expect: instance
