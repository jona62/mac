// Mac Language Showcase
// Generates a complex animated GIF using pipes, compose,
// arrows, effects, layout, and timeline

var t = Template("two_panel");
var blank = Template("blank");

// Data-driven meme generation with arrows
var captions = [
    ["Me: it works on my machine", "Prod: lol no"],
    ["Senior dev: we need tests", "The tests:"],
    ["git push --force", "The intern's branch:"],
    ["Me explaining my code", "Me reading it 2 weeks later"],
    ["Stack Overflow: just use regex", "The regex:"]
];

var memes = captions
    |> map(pair -> Meme(t)
        .text(Top, pair[0])
        .text(Bottom, pair[1]));

// Create effect presets using compose
var glitch = contrast(1.8) >> noise(0.2) >> pixelate(4);
var vintage = sepia >> brightness(0.9);
var clean = sharpen >> contrast(1.1);
var effects = [clean, vintage, glitch, deepfry, invert];

// Apply different effects to each frame
var styled = zip(memes, effects) |> map(pair -> pair[0] |> pair[1]);

// Build animation with reduce — fold memes into a timeline
var tl = styled |> reduce((tl, m) -> tl
    .frame(m, Duration(4000))
    .transition(crossfade, Duration(150)), Timeline());
tl.loop(0).render("showcase.gif");

print "Showcase GIF saved!";

// Effects comparison grid
[clean, vintage, glitch, deepfry]
    |> map(fx -> Meme(blank).text(Center, "Mac") |> fx)
    |> toGrid(2, 2)
    |> pad(5)
    |> border(2)
    |> save("showcase_grid.png");

print "Grid saved!";

// Countdown using animate pipeline
["5", "4", "3", "2", "1", "GO!"]
    |> map(n -> Meme(blank).text(Center, n))
    |> animate(Duration(1000))
    |> save("countdown.gif");

print "Countdown saved!";
