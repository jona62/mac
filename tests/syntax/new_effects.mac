// New effects
print type(hueShift);                // expect: function
print type(glow);                    // expect: function
print type(posterize);               // expect: function
print type(chromatic);               // expect: function
print type(threshold);               // expect: function
print type(tint);                    // expect: function
print type(grayscale);               // expect: function

// Compose new effects into presets
effect retro = grayscale >> contrast(1.3) >> noise(0.1);
print type(retro);                   // expect: function

effect cyber = hueShift(180) >> contrast(1.5) >> chromatic(3);
print type(cyber);                   // expect: function

effect comic = posterize(5) >> sharpen;
print type(comic);                   // expect: function
