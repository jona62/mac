// if/else
if (true) print "yes"; else print "no";
if (false) print "wrong"; else print "correct";

// while loop
var i = 0;
while (i < 5) {
    print i;
    i = i + 1;
}

// for loop
for (var j = 0; j < 3; j = j + 1) print j;

// logical operators
print "hi" or 2;
print nil or "yes";
print true and "result";
print false and "nope";
