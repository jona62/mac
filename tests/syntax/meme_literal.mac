// @template meme literal syntax

// Named positions
val m = @two_panel {
    top: "Hello"
    bottom: "World"
};
print type(m);                   // expect: instance

// One-liner (center text)
val m2 = @blank "Just this";
print type(m2);                  // expect: instance

// Access fields
print m.topText;                 // expect: Hello
print m.bottomText;              // expect: World
print m2.centerText;             // expect: Just this
print m2.bottomText;             // expect:

// Dotted template name (category.name)
val m3 = @meme.shrek_smirk {
    top: "Dotted"
    bottom: "Template"
};
print type(m3);                  // expect: instance
print m3.topText;                // expect: Dotted

val m4 = @blank {
    top: "North"
    center: "Middle"
    bottom: "South"
};
print m4.centerText;             // expect: Middle
