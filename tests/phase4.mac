// Basic function
fun add(a, b) {
    return a + b;
}
print add(1, 2);

// Recursion - fibonacci
fun fib(n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}
print fib(10);

// Closures
fun makeCounter() {
    var i = 0;
    fun count() {
        i = i + 1;
        return i;
    }
    return count;
}
var counter = makeCounter();
print counter();
print counter();
print counter();

// Native function
print clock();
