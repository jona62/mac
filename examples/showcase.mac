// Mac Language Showcase
// Guided demo covering user classes, typed prelude APIs,
// shared native metadata, effects, layout, GIFs, and timelines.

class Human {
    init(name) {
        this.name = name;
    }
}

class Person < Human {
    init(name, role) {
        this.name = name;
        this.role = role;
    }

    headline() {
        return this.role + ": " + this.name;
    }
}

var narrator = Person("Jonathan", "Builder");
print narrator.headline();

var twoPanel = Template("two_panel");
var blank = Template("blank");

var intro = Meme(twoPanel)
    .text(Top, narrator.headline())
    .text(Bottom, "Hints now come from real class metadata")
    .resize(Size(900, 900));

print intro.template.name;
print intro.topText;
print intro.width;

var glitch = contrast(1.6) >> noise(0.08) >> pixelate(3);
var spotlight = intro |> glitch;
save(spotlight, "showcase_intro.png");

var captions = [
    ["Built-ins and runtime", "now share one registry"],
    ["Prelude classes", "drive editor hints directly"],
    ["Dot completion", "comes from class members"],
    ["User classes", "get the same analyzer treatment"]
];

var frames = captions
    |> map(pair -> Meme(twoPanel)
        .text(Top, pair[0])
        .text(Bottom, pair[1])
        .resize(Size(800, 800)));

var gif = frames
    |> reduce((acc, frame) -> acc.frame(frame, Duration(450)), Gif());

print gif.frameCount;
gif.save("showcase.gif");
print "showcase gif saved";

var timeline = Timeline()
    .frame(intro, Duration(700))
    .transition(crossfade, Duration(160))
    .frame(spotlight, Duration(700))
    .transition(slideLeft, Duration(160))
    .frame(Meme(blank).text(Center, "Ship it"), Duration(700))
    .loop(0);

timeline.render("showcase_timeline.gif");
print "timeline gif saved";

var gallery = [
    intro,
    Meme(blank).text(Center, "Public fields"),
    Meme(blank).text(Center, "Frame count"),
    Meme(blank).text(Center, "Shared hints")
]
    |> toGrid(2, 2)
    |> pad(8)
    |> border(2);

save(gallery, "showcase_grid.png");
print "grid saved";
