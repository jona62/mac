// Layout
//
// Compositing functions for arranging memes. All pipeable.

// Place two memes side by side horizontally.
fun beside(left, right) -> Meme;

// Stack two memes vertically.
fun stack(top, bottom) -> Meme;

// Arrange memes into a grid with the given number of columns.
fun grid(cols, memes) -> Meme;

// Add white padding around a meme (in pixels).
fun pad(meme, pixels) -> Meme;

// Add a black border around a meme (in pixels).
fun border(meme, pixels) -> Meme;

// Arrange an array of memes into a grid (pipeline-friendly).
fun toGrid(memes, cols, rows) -> Meme;

// Create a GIF by giving each meme in the array the same duration.
fun animate(memes, duration) -> Gif;

// --- Transition type constants ---

var crossfade: string;
var slideLeft: string;
var slideRight: string;
var slideUp: string;
var slideDown: string;
var wipe: string;
