// New built-in templates
val t1 = Template("wide");
print type(t1);                      // expect: instance

val t2 = Template("tall");
print type(t2);                      // expect: instance

val t3 = Template("square");
print type(t3);                      // expect: instance

val t4 = Template("dark");
print type(t4);                      // expect: instance

val t5 = Template("four_panel");
print type(t5);                      // expect: instance

val t6 = Template("caption_bar");
print type(t6);                      // expect: instance

// Custom template from file path
val t7 = Template("assets/templates/blank.png");
print type(t7);                      // expect: instance

// @template with new templates
val m = @wide { top: "Wide" };
print type(m);                       // expect: instance

val m2 = @dark "Dark mode";
print type(m2);                      // expect: instance

// @"path" custom template syntax
val m3 = @"assets/templates/blank.png" "Custom path";
print type(m3);                      // expect: instance
