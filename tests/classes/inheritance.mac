class Animal {
    speak() { return "..."; }
}
class Dog < Animal {
    speak() { return "Woof!"; }
}
class Cat < Animal {}

print Dog().speak();       // expect: Woof!
print Cat().speak();       // expect: ...

// Super
class A {
    method() { return "A"; }
}
class B < A {
    method() { return "B"; }
    test() { return super.method(); }
}
print B().test();          // expect: A
