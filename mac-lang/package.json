{
  "name": "mac-lang",
  "displayName": "Mac Language",
  "description": "Syntax highlighting, language configuration, snippets, and LSP for the Mac programming language",
  "version": "0.2.0",
  "publisher": "jona62",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "icon": "icons/mac-file.svg",
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:mac"],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  },
  "contributes": {
    "languages": [
      {
        "id": "mac",
        "aliases": ["Mac", "mac"],
        "extensions": [".mac"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mac-file.svg",
          "dark": "./icons/mac-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mac",
        "scopeName": "source.mac",
        "path": "./syntaxes/mac.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mac",
        "path": "./snippets/mac.snippets.json"
      }
    ],
    "iconThemes": [
      {
        "id": "mac-icons",
        "label": "Mac File Icons",
        "path": "./mac-icon-theme.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.115.0",
    "typescript": "^6.0.2"
  }
}
