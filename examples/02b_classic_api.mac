// 02b — Classic Builder API
// The original Meme/Gif/Timeline classes still work.
// Use them when you need more control or dynamic construction.

// Create a meme with the builder pattern
var t = Template("two_panel");
var m = Meme(t)
    .text(Top, "When you write Java")
    .text(Bottom, "vs when you write Mac");
m.save(PNG, "classic_meme.png");

// Resize before saving
var small = m.resize(Size(300, 300));
small.save(PNG, "classic_small.png");

// Build a GIF frame by frame
var g = Gif();
g.frame(Meme(t).text(Top, "Frame 1"), Duration(500));
g.frame(Meme(t).text(Top, "Frame 2"), Duration(500));
g.frame(Meme(t).text(Top, "Frame 3"), Duration(500));
g.save("classic_gif.gif");

// Operator overloading: Meme + Duration = Frame, Gif + Frame = Gif
var f1 = Meme(t).text(Top, "A") + Duration(400);
var f2 = Meme(t).text(Top, "B") + Duration(400);
var composed = Gif() + f1 + f2;
composed.save("classic_composed.gif");

// Timeline with method chaining
Timeline()
    .frame(Meme(t).text(Top, "Scene 1"), Duration(2000))
    .transition(crossfade, Duration(150))
    .frame(Meme(t).text(Top, "Scene 2"), Duration(2000))
    .transition(slideLeft, Duration(150))
    .frame(Meme(t).text(Top, "Scene 3"), Duration(2000))
    .loop(0)
    .render("classic_timeline.gif");

// Dynamic construction with loops
var frames = Gif();
var labels = ["uno", "dos", "tres", "cuatro", "cinco"];
for (var i = 0; i < len(labels); i = i + 1) {
    frames.frame(
        Meme(Template("blank")).text(Center, labels[i]),
        Duration(600)
    );
}
frames.save("classic_loop.gif");

// Reduce into a Timeline
var memes = ["alpha", "beta", "gamma"]
    |> map(s -> Meme(Template("blank")).text(Center, s));

var tl = memes |> reduce((tl, m) -> tl
    .frame(m, Duration(2000))
    .transition(crossfade, Duration(200)), Timeline());
tl.loop(0).render("classic_reduce.gif");

print "Classic API examples saved to output/";
