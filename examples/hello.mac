// Hello, Mac!
print "Hello, Mac!";

// Variables and expressions
var x = 6;
var y = 7;
print x * y;

// Functions
fun greet(name) {
    return "Welcome to " + name + "!";
}
print greet("Mac");

// Arrow functions and pipes
var nums = [1, 2, 3, 4, 5];
print nums |> map(x -> x * x);
print nums |> filter(x -> x > 2) |> reverse;
