// stdlib/prelude.mac
// Mac Standard Library — loaded before user code

class Size {
    init(w, h) {
        this.width = w;
        this.height = h;
    }
    __add__(other) {
        return Size(this.width + other.width, this.height + other.height);
    }
    __mul__(n) {
        return Size(this.width * n, this.height * n);
    }
    __eq__(other) {
        return this.width == other.width and this.height == other.height;
    }
}

class Duration {
    init(ms) {
        this.ms = ms;
    }
    __add__(other) {
        return Duration(this.ms + other.ms);
    }
    __mul__(n) {
        return Duration(this.ms * n);
    }
    __eq__(other) {
        return this.ms == other.ms;
    }
}

class Position {
    init(name) { this.name = name; }
    __eq__(other) { return this.name == other.name; }
}
var Top = Position("top");
var Bottom = Position("bottom");
var Center = Position("center");

class Format {
    init(name) { this.name = name; }
    __eq__(other) { return this.name == other.name; }
}
var PNG = Format("png");
var JPG = Format("jpg");
var GIF = Format("gif");

class Template {
    init(nameOrPath) {
        this.name = nameOrPath;
        this.path = _resolve_template(nameOrPath);
    }
}

class Frame {
    init(memeObj, duration) {
        this.meme = memeObj;
        this.duration = duration;
    }
}

class Meme {
    init(template) {
        this.template = template;
        this.topText = "";
        this.bottomText = "";
        this.width = 0;
        this.height = 0;
        this.renderedPath = nil;
    }
    text(position, str) {
        var m = Meme(this.template);
        m.topText = this.topText;
        m.bottomText = this.bottomText;
        m.width = this.width;
        m.height = this.height;
        m.renderedPath = this.renderedPath;
        if (position == Top) m.topText = str;
        if (position == Bottom) m.bottomText = str;
        if (position == Center) m.bottomText = str;
        return m;
    }
    save(format, path) {
        if (this.renderedPath) {
            _save_rendered(this.renderedPath, path);
        } else {
            _meme_save(this.template.path, this.topText, this.bottomText,
                       this.width, this.height, path);
        }
    }
    resize(size) {
        var m = Meme(this.template);
        m.topText = this.topText;
        m.bottomText = this.bottomText;
        m.width = size.width;
        m.height = size.height;
        m.renderedPath = this.renderedPath;
        return m;
    }
    __add__(other) {
        return Frame(this, other);
    }
}

class Gif {
    init() {
        this._frames = [];
        this.frameCount = 0;
    }
    frame(memeObj, duration) {
        push(this._frames, {
            path: memeObj.template.path,
            top: memeObj.topText,
            bottom: memeObj.bottomText,
            width: memeObj.width,
            height: memeObj.height,
            duration: duration.ms
        });
        this.frameCount = len(this._frames);
        return this;
    }
    save(path) {
        _gif_save(this._frames, path);
    }
    __add__(other) {
        this.frame(other.meme, other.duration);
        return this;
    }
}

// Composed effect preset
var deepfry = saturate(3.0) >> contrast(2.0) >> jpeg(10) >> noise(0.1);

// Transition type constants
var crossfade = "crossfade";
var slideLeft = "slideLeft";
var slideRight = "slideRight";
var slideUp = "slideUp";
var slideDown = "slideDown";
var wipe = "wipe";

class Timeline {
    init() {
        this._tl = timeline();
    }
    frame(memeObj, duration) {
        _timeline_keyframe(this._tl, memeObj);
        _timeline_hold(this._tl, duration.ms);
        return this;
    }
    transition(transType, duration) {
        _timeline_transition(this._tl, duration.ms, transType);
        return this;
    }
    loop(count) {
        _timeline_loop(this._tl, count);
        return this;
    }
    render(path) {
        _timeline_render(this._tl, path);
        return this;
    }
    save(path) {
        _timeline_render(this._tl, path);
        return this;
    }
    __add__(other) {
        this.frame(other.meme, other.duration);
        return this;
    }
}
