// ============================================================
//  ADVANCED MAC ANIMATION GUIDE
//  Techniques for creating cinematic, data-driven graphics
// ============================================================
//
//  1. STYLE AS IDENTITY
//     Define styles as visual characters, not just formatting.
//     Name them by mood, not appearance. Pair complementary
//     outline/shadow colors with the text color for depth.
//
//     style ember { color: "#FF3300" outline: 3
//         outlineColor: "#330000" shadow: 8
//         shadowColor: "#FF330099" }
//
//  2. EFFECTS AS VERBS
//     Compose effects into named pipelines that describe
//     what they DO. Chain 3-4 effects max.
//
//     effect burn = saturate(3.0) >> contrast(2.2) >> glow(12);
//     effect ghost = brightness(0.6) >> blur(2) >> glow(6);
//
//  3. DATA-DRIVEN FRAMES
//     Store visual parameters in arrays of maps. Generate
//     frames with range() |> map(). Define styles inline
//     from the data inside the lambda.
//
//     val palette = [{ fg: "#00FF88", bg: "#001a0d" }, ...];
//     val frames = range(4) |> map(i -> {
//         style s { color: palette[i]["fg"] }
//         @dark 700x700 s { center: labels[i] } |> effects[i]
//     });
//
//  4. SPREAD FOR COMPOSITION
//     Use ... to spread arrays into grids and array literals.
//     Auto-dimensions infer layout from data shape.
//
//     grid 2x2 { ...frames } => "grid.png";
//     val bounce = [...frames, ...reverse(frames)];
//
//  5. PROGRAMMATIC GIFS
//     Use reduce() + Gif() + .frame() to build animations
//     from arrays. Chain .frame() for closing scenes.
//
//     val anim = frames
//         |> reduce((g, f) -> g.frame(f, Duration(200)), Gif());
//     anim.frame(@dark "fin", Duration(1000)).save("out.gif");
//
//  6. PACING AND RHYTHM
//     Short durations (100-200ms) for strobes, medium
//     (500ms-1s) for beats, long (1.5-3s) for holds.
//     Transitions create flow - crossfade for smooth,
//     fadeBlack for dramatic, zoom bounce for emphasis.
//
//  7. CONTRAST DRIVES INTEREST
//     Alternate density with emptiness. Follow a glitch
//     frame with a clean one. End with simplicity.
//
// ============================================================


// ============================================================
// "Pulse" - kinetic typography as motion design
// Techniques: style contrast, effect pipelines, pacing
// ============================================================

style mono {
    color: "#FFFFFF"
    outline: 0
    bold: false
    uppercase: false
}

style heavy {
    color: "#FFFFFF"
    outline: 6
    outlineColor: "#000000"
}

style ember {
    color: "#FF3300"
    outline: 3
    outlineColor: "#330000"
    shadow: 8
    shadowColor: "#FF330099"
}

style void {
    color: "#000000"
    outline: 2
    outlineColor: "#333333"
}

style electric {
    color: "#00EEFF"
    outline: 2
    outlineColor: "#003344"
    shadow: 6
    shadowColor: "#00EEFF77"
}

style flicker {
    color: "#FFFF00"
    outline: 2
    outlineColor: "#444400"
    shadow: 4
    shadowColor: "#FFFF0066"
}

effect clean = contrast(1.0);
effect burn = saturate(3.0) >> contrast(2.2) >> glow(12) >> noise(0.08);
effect ghost = brightness(0.6) >> blur(2) >> glow(6) >> contrast(1.3);
effect overload = chromatic(8) >> contrast(2.0) >> saturate(3.0) >> glow(8);
effect glitch = noise(0.3) >> contrast(1.8) >> pixelate(3);
effect fade_out = brightness(0.3) >> contrast(0.8);

gif {
    @dark 720x720 mono { center: "." } |> clean : 800ms
    --- crossfade 200ms ---
    @dark 720x720 mono { center: ". ." } |> clean : 400ms
    @dark 720x720 mono { center: ". . ." } |> clean : 400ms
    --- crossfade 150ms ---
    @dark 720x720 heavy { center: "PULSE" } |> clean : 600ms
    --- fadeBlack 100ms ---
    @dark 720x720 ember { center: "PULSE" } |> burn : 500ms
    --- crossfade 80ms ---
    @dark 720x720 ember { center: "PULSE" } |> ghost : 400ms
    --- fadeBlack 200ms ---
    @blank 720x720 void { center: "P U L S E" } |> glitch : 300ms
    @dark 720x720 void { center: "P U L S E" } |> glitch : 300ms
    @blank 720x720 void { center: "P U L S E" } |> glitch : 200ms
    --- fadeBlack 150ms ---
    @dark 720x720 electric { center: "P" } |> overload : 250ms
    @dark 720x720 electric { center: "PU" } |> overload : 200ms
    @dark 720x720 electric { center: "PUL" } |> overload : 200ms
    @dark 720x720 electric { center: "PULS" } |> overload : 200ms
    @dark 720x720 electric { center: "PULSE" } |> overload : 500ms
    --- crossfade 300ms easeOut ---
    @dark 720x720 mono { center: "PULSE" } |> clean : 1s
    --- crossfade 400ms easeInOut ---
    @dark 720x720 flicker { top: "every" center: "system" bottom: "has one" } |> glow(6) : 1.5s
    --- fadeBlack 500ms ---
    @dark 720x720 mono { center: "________" } |> fade_out : 1.2s
    --- crossfade 300ms ---
    @dark 720x720 ember { center: "." } |> burn : 400ms
    --- fadeBlack 600ms ---
} => "pulse.gif";


// ============================================================
// "Chromatic Decay" - procedural animation via functional pipes
// Techniques: data-driven frames, spread grids, expression blocks
// ============================================================

val palette = [
    { fg: "#00FF88", bg: "#001a0d", glow: "#00FF8877" },
    { fg: "#FF0066", bg: "#1a000a", glow: "#FF006677" },
    { fg: "#8844FF", bg: "#0d0022", glow: "#8844FF77" },
    { fg: "#FF8800", bg: "#1a0e00", glow: "#FF880077" },
];

val effects = [
    glow(6) >> contrast(1.4),
    chromatic(6) >> glow(8) >> saturate(2.0),
    pixelate(2) >> noise(0.12) >> contrast(1.6),
    saturate(2.5) >> glow(10) >> contrast(1.8),
];

val phases = ["SIGNAL", "DRIFT", "STATIC", "THERMAL"];
val sub = ["locked", "unstable", "breaking", "critical"];

val frames = range(4) |> map(i -> {
    val p = palette[i];
    style s {
        color: p["fg"]
        outline: 3
        outlineColor: p["bg"]
        shadow: 6
        shadowColor: p["glow"]
    }
    @dark 700x700 s {
        top: phases[i]
        bottom: sub[i]
    } |> effects[i]
});

gif {
    frames[0] : 1.5s
    --- crossfade 400ms easeInOut ---
    frames[1] : 1.5s
    --- slideLeft 300ms easeOut ---
    frames[2] : 1.5s
    --- zoom 400ms bounce ---
    frames[3] : 1.5s
    --- fadeBlack 500ms ---
    frames[0] : 200ms
    frames[1] : 200ms
    frames[2] : 200ms
    frames[3] : 200ms
    --- fadeBlack 300ms ---
    @dark 700x700 mono { center: "entropy wins" } |> brightness(0.5) >> vignette : 2s
    --- fadeBlack 800ms ---
} => "chromatic_decay.gif";


// ============================================================
// "Frequencies" - a data-driven visual synthesizer
// Techniques: array spread, reduce+Gif, programmatic concat
// ============================================================

val bands = [
    { hz: "60",   label: "SUB",   color: "#FF0044", glow: "#FF004488", fx: blur(3) >> glow(12) >> saturate(2.0) },
    { hz: "250",  label: "LOW",   color: "#FF6600", glow: "#FF660088", fx: glow(8) >> contrast(1.6) >> noise(0.05) },
    { hz: "1K",   label: "MID",   color: "#FFCC00", glow: "#FFCC0088", fx: contrast(1.8) >> sharpen >> glow(4) },
    { hz: "4K",   label: "HIGH",  color: "#00FF88", glow: "#00FF8888", fx: chromatic(4) >> glow(6) >> saturate(1.8) },
    { hz: "12K",  label: "AIR",   color: "#00CCFF", glow: "#00CCFF88", fx: chromatic(8) >> glow(10) >> brightness(1.1) },
    { hz: "20K",  label: "ULTRA", color: "#AA44FF", glow: "#AA44FF88", fx: pixelate(2) >> chromatic(6) >> glow(8) },
];

val band_frames = bands |> map(b -> {
    style freq {
        color: b["color"]
        outline: 3
        outlineColor: "#000000"
        shadow: 5
        shadowColor: b["glow"]
    }
    @dark 720x400 freq {
        top: "{b[\"hz\"]} Hz"
        bottom: b["label"]
    } |> b["fx"]
});

// Sweep: each band crossfades in sequence
gif {
    @dark 720x400 mono { center: "..." } |> brightness(0.3) : 600ms
    --- fadeBlack 200ms ---
    band_frames[0] : 500ms
    --- crossfade 150ms ---
    band_frames[1] : 500ms
    --- crossfade 150ms ---
    band_frames[2] : 500ms
    --- crossfade 150ms ---
    band_frames[3] : 500ms
    --- crossfade 150ms ---
    band_frames[4] : 500ms
    --- crossfade 150ms ---
    band_frames[5] : 500ms
    --- fadeBlack 300ms ---
} => "frequencies_sweep.gif";

// Strobe: forward + reverse bounce via array spread + reduce
val strobe = [...band_frames, ...reverse(band_frames)]
    |> reduce((g, f) -> g.frame(f, Duration(120)), Gif());

strobe
    .frame(@dark 720x400 mono { center: "FULL SPECTRUM" } |> glow(6) >> contrast(1.4), Duration(1200))
    .frame(@dark 720x400 mono { center: "~" } |> noise(0.4) >> brightness(0.4), Duration(800))
    .save("frequencies_strobe.gif");

print "3 animations saved: pulse.gif, chromatic_decay.gif, frequencies_sweep.gif, frequencies_strobe.gif";
